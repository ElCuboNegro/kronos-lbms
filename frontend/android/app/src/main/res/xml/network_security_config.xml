<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">192.168.80.185</domain>
        <!-- Permite tráfico HTTP normal para las IPs de la red local (Común en Dev) -->
        <domain includeSubdomains="true">192.168.1.1</domain>
    </domain-config>
    <!-- Configuración general para aceptar HTTP puro si "cleartext" se pide a nivel global -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
